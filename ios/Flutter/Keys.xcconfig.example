# Google Maps SDK key cho iOS.
#
# CÁCH DÙNG:
#   1. Copy file này thành Keys.xcconfig:
#        cp Keys.xcconfig.example Keys.xcconfig
#   2. Bật "Maps SDK for iOS" cho key tại Google Cloud Console.
#   3. Thay YOUR_GOOGLE_MAPS_API_KEY bằng key thật.
#
# Keys.xcconfig đã được thêm vào .gitignore → KHÔNG commit key lên git.

GOOGLE_MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY

# ── Cấu hình admin_web (đọc từ .env, KHÔNG commit file .env thật) ────────────
# Copy file này thành `.env` rồi điền giá trị thật.

# ── MongoDB ───────────────────────────────────────────────────────────────
# Connection string đầy đủ, ví dụ:
#   mongodb://user:pass@host:27017/?authSource=admin
#   mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017

# Tên database trong MongoDB (để trống = tự dò)
MONGO_DB=

# Tên collection chứa cây cá nhân / lịch sử nhận diện (để trống = tự dò)
MONGO_USER_PLANTS_COLLECTION=

# Tên collection chứa lịch sử chat (để trống = tự dò)
MONGO_CHAT_COLLECTION=

# ── Backend API (để lấy profile đầy đủ cho user) ─────────────────────────
API_BASE_URL=http://222.255.184.116

# Danh sách "username:password" để đăng nhập lấy profile, phân cách bằng dấu phẻm
# Ví dụ: admin:123456,user1:123456
# Để trống = bỏ qua bước enrich profile (web vẫn chạy, chỉ thiếu tên/email)
AUTH_CREDENTIALS=

# ── Web server ────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080

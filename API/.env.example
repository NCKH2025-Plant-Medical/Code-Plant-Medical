# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/plant_database?retryWrites=true&w=majority

# JWT Settings
SECRET_KEY=your_super_secret_jwt_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MySQL Database Settings (if using database.py)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=plant_project
